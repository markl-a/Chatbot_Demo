# Hugging Face Configuration
HF_TOKEN=your_huggingface_token_here
HF_READ_TOKEN=your_huggingface_read_token_here
HF_WRITE_TOKEN=your_huggingface_write_token_here

# Model Configuration
BASE_MODEL_NAME=taide/TAIDE-LX-7B-Chat
FINE_TUNED_MODEL_NAME=mark1098/TAIDE-LX-7B-Chat-Medical-Fintune
ALTERNATIVE_MODEL_NAME=MediaTek-Research/Breeze-7B-Instruct-v1_0

# Dataset Configuration
DATASET_URL=https://huggingface.co/datasets/ChenWeiLi/Medtext_zhtw/raw/main/MedText_zhtw.json
DATASET_PATH=data/raw/MedText_zhtw.json

# Training Configuration
OUTPUT_DIR=./models/checkpoints
LOGGING_DIR=./logs
MAX_LENGTH=384
BATCH_SIZE=64
GRADIENT_ACCUMULATION_STEPS=4
LEARNING_RATE=5e-5
NUM_EPOCHS=40
SAVE_STEPS=50
SAVE_TOTAL_LIMIT=5

# LoRA Configuration
LORA_R=8
LORA_ALPHA=32
LORA_DROPOUT=0.1

# Inference Configuration
MAX_NEW_TOKENS=90
TEMPERATURE=0.15
TOP_P=0.15
TOP_K=50
REPETITION_PENALTY=1.6

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1
GRADIO_SHARE=false

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=logs/medical_chatbot.log

# Device Configuration
DEVICE=cuda
TORCH_DTYPE=bfloat16

# Google Drive (for Colab)
GDRIVE_MOUNT=/content/drive
GDRIVE_OUTPUT=/content/drive/MyDrive/colab_results
GDRIVE_LOGS=/content/drive/MyDrive/colab_logs
